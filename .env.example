# HermesMesh Configuration
# Copy this to .env and adjust values

# Database (SQLite by default, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./hermesmesh.db

# Controller settings
HERMES_HOST=0.0.0.0
HERMES_PORT=8000

# Security (generate strong random values)
HERMES_SECRET_KEY=change-me-in-production
HERMES_ENROLLMENT_EXPIRY_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Agent settings
AGENT_HEARTBEAT_INTERVAL_SECONDS=5
AGENT_RETRY_INTERVAL_SECONDS=30

# GPU detection
ENABLE_GPU_MONITORING=true

# Model providers
OLLAMA_ENDPOINT=http://localhost:11434
